{
  "name": "enviolegalv2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test --require ./tests/register.js tests/**/*.test.ts",
    "test:v2:unit": "NODE_ENV=test node --test --require ./tests/register.js \"tests-v2/unit/**/*.test.ts\"",
    "test:v2:coverage": "NODE_ENV=test c8 --all --include=\"lib/**/*.ts\" --include=\"app/**/*.ts\" --reporter=text --reporter=html node --test --require ./tests/register.js \"tests-v2/unit/**/*.test.ts\"",
    "test:v2:integration": "node --test --require ./tests/register.js \"tests-v2/integration/**/*.test.ts\"",
    "test:v2:e2e": "npx playwright test --config=playwright.v2.config.ts",
    "lint:fix": "eslint --fix .",
    "audit:forms": "ts-node --transpile-only scripts/audit-forms.ts",
    "geocode:collectors": "npx tsx scripts/geocode-collectors.ts",
    "fipe:sync": "npx tsx scripts/fipe-sync.ts",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@mercadopago/sdk-react": "^1.0.6",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/bcrypt": "^6.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^7.0.3",
    "@zxing/library": "^0.21.3",
    "antd": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bwip-js": "^4.8.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "jspdf": "^3.0.3",
    "leaflet": "^1.9.4",
    "mercadopago": "^2.10.0",
    "nanoid": "^5.1.6",
    "next": "^16.0.4",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.30.0",
    "react": "^19.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.3.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.0.6",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/pino-pretty": "^4.7.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.8.32",
    "c8": "^10.1.3",
    "eslint": "^9",
    "eslint-config-next": "^16.0.4",
    "husky": "^9.1.7",
    "prisma": "^7.0.1",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
