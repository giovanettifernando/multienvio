{
  "name": "enviolegalv2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "NODE_ENV=test node --test --require ./tests/register.js \"tests/unit/**/*.test.ts\"",
    "test:unit": "NODE_ENV=test node --test --require ./tests/register.js \"tests/unit/**/*.test.ts\"",
    "test:coverage": "NODE_ENV=test c8 --all --include=\"lib/**/*.ts\" --include=\"modules/**/*.ts\" --include=\"shared/**/*.ts\" --include=\"platform/**/*.ts\" --include=\"app/**/*.ts\" --reporter=text --reporter=html node --test --require ./tests/register.js \"tests/unit/**/*.test.ts\"",
    "test:integration": "NODE_ENV=test node --test --require ./tests/register.js \"tests/integration/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "lint:fix": "eslint --fix .",
    "audit:forms": "ts-node --transpile-only scripts/audit-forms.ts",
    "geocode:collectors": "tsx scripts/geocode-collectors.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "workers": "tsx --conditions react-server workers/index.ts",
    "workers:dev": "tsx --conditions react-server watch workers/index.ts",
    "workers:check": "tsc --noEmit --project tsconfig.workers.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.2.0",
    "@api/loggi-platform": "file:.api/apis/loggi-platform",
    "@bull-board/api": "^6.19.0",
    "@bull-board/express": "^6.19.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@tanstack/react-query": "^5.90.2",
    "@zxing/library": "^0.21.3",
    "antd": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.1",
    "bwip-js": "^4.8.0",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "jspdf": "^4.2.0",
    "leaflet": "^1.9.4",
    "nanoid": "^5.1.6",
    "next": "^16.0.4",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "react": "^19.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.2",
      "lodash": "^4.17.23",
      "minimatch": "^10.2.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.0.6",
    "@playwright/test": "^1.56.1",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/bcrypt": "^6.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/pino-pretty": "^4.7.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.0",
    "c8": "^10.1.3",
    "eslint": "^9",
    "eslint-config-next": "^16.0.4",
    "husky": "^9.1.7",
    "prisma": "^7.4.1",
    "puppeteer": "^24.30.0",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.7",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
