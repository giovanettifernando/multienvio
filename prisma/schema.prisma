// Cache de coordenadas geocodificadas por CEP usando PostGIS
model CepLocation {
  cep                   String   @id
  latitude              Float
  longitude             Float
  precision             String?
  provider              String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")
  manualOverride        Boolean  @default(false) @map("manual_override")
  manualOverrideReason  String?  @map("manual_override_reason")

  @@map("cep_locations")
}

model RecurringItem {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  descricao      String
  valorUnitario  Float    @map("valor_unitario")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recurring_items")
}
