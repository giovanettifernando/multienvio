generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("roles")
}

model User {
  id                       String                    @id @default(uuid())
  name                     String
  email                    String                    @unique
  passwordHash             String?
  phone                    String?
  status                   String                    @default("pending")
  roleId                   String?
  lastLoginAt              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  emailVerificationToken   String?                   @unique
  emailVerified            Boolean                   @default(false)
  emailVerifiedAt          DateTime?
  termsAcceptedAt          DateTime?
  avatarUrl                String?
  googleId                 String?                   @unique
  authProvider             String                    @default("email")
  cpf                      String?
  cnpj                     String?
  hasCompany               Boolean                   @default(false)
  razaoSocial              String?
  passwordUpdatedAt        DateTime?
  passwordHistory          Json?
  defaultPostingUnitId     String?
  addresses                Address[]
  cards                    Card[]
  carts                    Cart[]
  passwordResetTokens      PasswordResetToken[]
  paymentTransactions      PaymentTransaction[]
  quotes                   Quote[]
  recipients               Recipient[]
  receivedShipments        Shipment[]                @relation("RecipientShipments")
  sentShipments            Shipment[]                @relation("SenderShipments")
  supportTickets           SupportTicket[]
  securityEvents           UserSecurityEvent[]
  packagingTemplates       PackagingTemplate[]
  recurringItems           RecurringItem[]
  role                     Role?                     @relation(fields: [roleId], references: [id])
  wallet                   Wallet?
  pickupRequests           PickupRequest[]
  trackingCodeReservations TrackingCodeReservation[]
  recipientPaymentRequests RecipientPaymentRequest[]
  assistantChatSessions    AssistantChatSession[]

  // Removidos índices redundantes: email, emailVerificationToken, googleId já são @unique
  @@map("users")
}

model Address {
  id           String   @id @default(uuid())
  cep          String   @db.VarChar(8)
  logradouro   String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  uf           String   @db.VarChar(2)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDefault    Boolean  @default(false)
  label        String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingCards Card[]   @relation("BillingAddress")

  @@index([userId])
  @@index([cep])
  @@map("addresses")
}

model Card {
  id               String    @id @default(cuid())
  userId           String
  brand            CardBrand
  holderName       String
  last4            String    @db.VarChar(4)
  expMonth         Int
  expYear          Int
  fingerprint      String
  isDefault        Boolean   @default(false)
  billingAddressId String?
  vaultToken       String    @unique
  panCipher        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  billingAddress   Address?  @relation("BillingAddress", fields: [billingAddressId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([userId, isDefault])
  @@map("cards")
}

model Recipient {
  id          String   @id @default(cuid())
  userId      String
  name        String
  nameSearch  String
  email       String?  @db.VarChar(160)
  document    String?  @db.VarChar(14)
  phone       String?  @db.VarChar(20)
  notes       String?  @db.VarChar(280)
  isDefault   Boolean  @default(false)
  cep         String   @db.VarChar(8)
  logradouro  String
  numero      String   @db.VarChar(20)
  complemento String?
  bairro      String
  cidade      String
  uf          String   @db.VarChar(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Removido @@index([userId]) - coberto pelos compostos abaixo
  @@index([userId, isDefault])
  @@index([userId, document])
  @@index([userId, name])
  @@index([userId, nameSearch])
  @@map("recipients")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  status    String     @default("OPEN")
  totals    Json?
  meta      Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  originAddress  Json
  destination    Json
  volumes        Json
  preferences    Json
  insuranceValue Decimal?
  pickupPoint    Json?
  pickupFee      Json?
  selectedQuote  Json
  totals         Json
  document       Json? // Documento fiscal: type (NFE/DECLARACAO), volumeDeclarations, packages, etc.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

model Shipment {
  id                              String                   @id @default(uuid())
  platformTrackingCode            String                   @unique // Código interno Envio Legal (customer-facing)
  carrierTrackingCode             String? // Código da transportadora - primeiro volume ou único (para compatibilidade)
  carrierMetadata                 Json? // Metadados resumidos (serviceCode, serviceName, totalPrice, isMultiVolume)
  senderId                        String
  recipientId                     String?
  recipientName                   String?
  recipientPhone                  String?
  recipientEmail                  String?
  recipientDocument               String?
  destinationAddress              String?
  destinationNeighborhood         String?
  destinationCity                 String
  destinationState                String
  weight                          Float
  declaredValue                   Float
  status                          String                   @default("PICKUP_REQUESTED") /// @ShipmentStatus - Deve seguir enum ShipmentStatus (UPPER_SNAKE_CASE)
  carrier                         String?
  service                         String?
  originCep                       String
  destinationCep                  String
  estimatedDays                   Int?
  freightCost                     Float?
  pickupFee                       Float? // Taxa de coleta (comissão do coletor)
  pickupPointId                   String?
  document                        Json?
  paymentMethod                   String?
  publicTrackingId                String?                  @unique @default(cuid())
  postedAt                        DateTime?
  receivedAt                      DateTime? // Data/hora de recepção no hub
  receivedBy                      String? // ID do usuário que registrou a recepção
  deliveredAt                     DateTime?
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt
  // Campos de comissão da plataforma (para reconciliação)
  platformShippingCommissionCents Int?                     @map("platform_shipping_commission_cents") // Comissão sobre frete em centavos
  platformPickupCommissionCents   Int?                     @map("platform_pickup_commission_cents") // Comissão sobre coleta em centavos
  recipient                       User?                    @relation("RecipientShipments", fields: [recipientId], references: [id])
  sender                          User                     @relation("SenderShipments", fields: [senderId], references: [id])
  trackingEvents                  TrackingEvent[]
  label                           Label?
  pickupRequest                   PickupRequest?
  packages                        Package[]
  recipientPaymentRequest         RecipientPaymentRequest?

  @@index([platformTrackingCode])
  @@index([carrierTrackingCode])
  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([publicTrackingId])
  @@index([senderId, status]) // Composite index for user shipments filter
  @@index([createdAt]) // Index for date range queries
  @@index([senderId, status, createdAt]) // Composite for filtered listing with sorting
  @@map("shipments")
}

model Label {
  id            String    @id @default(uuid())
  shipmentId    String    @unique
  carrier       String
  service       String
  status        String    @default("pending") // pending, paid, issued, canceled, error
  priceCents    Int // Preço em centavos
  currency      String    @default("BRL")
  trackingCode  String?
  recipientName String? // Nome do destinatário (denormalizado)
  fileUrl       String? // URL do PDF da etiqueta
  fileBase64    String?   @db.Text // Base64 do PDF (se aplicável)
  contentType   String?   @default("application/pdf")
  sizeBytes     Int?
  isPrinted     Boolean   @default(false) // Status de impressão
  printedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Removido @@index([shipmentId]) - shipmentId é @unique
  @@index([status])
  @@index([isPrinted])
  @@index([createdAt])
  @@index([status, isPrinted]) // Composite for filtered listing
  @@index([trackingCode]) // PERFORMANCE: Lookups por código de rastreio
  @@map("labels")
}

model Package {
  id                     String    @id @default(uuid())
  shipmentId             String
  packageNumber          Int // Número sequencial do volume (1, 2, 3...)
  width                  Float // Largura em cm
  height                 Float // Altura em cm
  length                 Float // Comprimento em cm
  weight                 Float // Peso em kg
  // Dados específicos da transportadora (Correios)
  carrierTrackingCode    String? // Código de rastreio deste volume (ex: AB123456789BR)
  carrierPrePostageId    String? // ID da pré-postagem (ex: PRNnhoiSb6SSKvvVJA13MiOA)
  carrierQuotePrice      Float? // Preço do frete deste volume
  hasDivergence          Boolean   @default(false)
  divergenceType         String? // "DIMENSAO", "PESO", "DIMENSAO_E_PESO"
  divergenceNotes        String?   @db.Text
  divergenceWidth        Float? // Nova largura (se houver divergência)
  divergenceHeight       Float? // Nova altura (se houver divergência)
  divergenceLength       Float? // Novo comprimento (se houver divergência)
  divergenceWeight       Float? // Novo peso (se houver divergência)
  divergencePhotoUrl     String? // URL da foto da divergência (opcional)
  divergenceRegisteredAt DateTime?
  divergenceRegisteredBy String? // ID do usuário que registrou
  checkedAt              DateTime?
  checkedBy              String? // ID do usuário que conferiu
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  shipment               Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, packageNumber])
  @@index([shipmentId])
  @@index([hasDivergence])
  @@index([checkedAt])
  @@index([carrierTrackingCode]) // Busca por código de rastreio do volume
  @@map("packages")
}

model PickupRequest {
  id                   String     @id @default(cuid())
  companyId            String? // ID da empresa (se aplicável)
  userId               String // Usuário que solicitou a coleta
  collectorId          String? // ID do coletor atribuído
  shipmentId           String     @unique // Garantir 1 coleta por shipment
  originCep            String
  originAddress        String?
  originCity           String?
  originUf             String?    @db.VarChar(2)
  windowStart          DateTime? // Início da janela de coleta
  windowEnd            DateTime? // Fim da janela de coleta
  status               String     @default("PENDING") // PENDING, SCHEDULED, COLLECTED, FAILED, CANCELED, COMPLETED
  notes                String?    @db.Text
  collectedAt          DateTime? // Data/hora em que a coleta foi realizada
  collectedBy          String? // Nome de quem entregou os volumes
  scannedCode          String? // Código de rastreio lido/digitado pelo coletor
  deliveredToCarrierAt DateTime? // Data/hora em que foi entregue na transportadora
  carrierRecipient     String? // Nome de quem recebeu na transportadora
  carrierUnit          String? // Unidade da transportadora onde foi entregue
  scheduleAt           DateTime? // Data/hora agendada pelo coletor para realizar a coleta
  attemptCount         Int        @default(0) // Contador de tentativas de coleta
  attemptNotes         Json? // Histórico de tentativas com data/hora e observações
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collector            Collector? @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  shipment             Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Removidos @@index([userId]), @@index([collectorId]), @@index([shipmentId]) - cobertos por compostos/unique
  @@index([status])
  @@index([createdAt])
  @@index([originCep])
  @@index([scheduleAt])
  @@index([userId, status, createdAt]) // PERFORMANCE: Dashboard do usuário
  @@index([collectorId, status]) // PERFORMANCE: Dashboard do coletor
  @@index([collectorId, collectedAt]) // PERFORMANCE: Coletas realizadas pelo coletor
  @@map("pickup_requests")
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  type        String
  description String
  city        String?
  uf          String?  @db.VarChar(2)
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt]) // PERFORMANCE: Eventos ordenados por data
  @@map("tracking_events")
}

model StaffRole {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  users     StaffUser[]

  @@map("staff_roles")
}

model StaffUser {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String            @map("passwordHash")
  status       StaffStatus       @default(ACTIVE)
  roleId       String            @map("roleId")
  lastLoginAt  DateTime?         @map("lastLoginAt")
  createdAt    DateTime          @default(now()) @map("createdAt")
  updatedAt    DateTime          @updatedAt @map("updatedAt")
  lastAccessAt DateTime?         @map("lastAccessAt")
  phone        String?
  isSuperAdmin Boolean           @default(false)
  permissions  AdminPermission[] @default([])
  auditLogs    StaffAuditLog[]
  role         StaffRole         @relation(fields: [roleId], references: [id])

  @@index([email])
  @@map("staff_users")
}

model StaffAuditLog {
  id        String     @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime   @default(now())
  actor     StaffUser? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("staff_audit_logs")
}

model UserSecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
  @@map("user_security_events")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  // Removido @@index([tokenHash]) - tokenHash é @unique
  @@map("password_reset_tokens")
}

model Wallet {
  id             String              @id @default(cuid())
  userId         String              @unique
  availableCents Int                 @default(0)
  pendingCents   Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   WalletTransaction[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id          String         @id @default(cuid())
  walletId    String
  type        WalletTxType
  status      WalletTxStatus @default(PENDING)
  amountCents Int
  title       String?
  referenceId String?        @unique
  meta        Json?
  createdAt   DateTime       @default(now())
  confirmedAt DateTime?
  wallet      Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status, createdAt])
  @@index([referenceId])
  @@index([status, confirmedAt]) // PERFORMANCE: Queries de relatório
  @@map("wallet_transactions")
}

model SupportTicket {
  id             String              @id @default(cuid())
  userId         String?
  subject        String
  description    String
  status         SupportTicketStatus @default(OPEN)
  priority       SupportPriority     @default(MEDIUM)
  assignedTo     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lastActivityAt DateTime            @default(now())
  tags           Json?
  pickupPointId  String?
  collectorId    String?
  messages       SupportMessage[]
  pickupPoint    PickupPoint?        @relation(fields: [pickupPointId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  collector      Collector?          @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
  @@index([pickupPointId, createdAt])
  @@index([collectorId, createdAt])
  @@index([assignedTo])
  @@index([lastActivityAt]) // PERFORMANCE: Ordenação por atividade recente
  @@map("support_tickets")
}

model SupportMessage {
  id          String              @id @default(cuid())
  ticketId    String
  authorId    String
  authorRole  SupportAuthorRole
  body        String
  isInternal  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  attachments SupportAttachment[]
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportAttachment {
  id        String         @id @default(cuid())
  messageId String
  filename  String
  url       String
  size      Int?
  createdAt DateTime       @default(now())
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("support_attachments")
}

model PickupPoint {
  id                String            @id @default(cuid())
  status            PickupPointStatus @default(ACTIVE)
  razaoSocial       String
  nomeFantasia      String
  cnpj              String            @unique
  ie                String?
  email             String?
  telefone          String?
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  uf                String?           @db.VarChar(2)
  // geo removido - usar apenas CEP para geolocalização
  paymentMethod     Json
  payoutDay         Int?
  minPayoutAmount   Decimal?          @db.Decimal(10, 2)
  commissionPerItem Decimal?          @db.Decimal(10, 2)
  capacityPerDay    Int?
  monthlyReceived   Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  passwordHash      String?
  receptions        Reception[]
  supportTickets    SupportTicket[]

  @@index([status])
  @@index([uf, cidade])
  @@index([cnpj])
  @@map("pickup_points")
}

model Reception {
  id              String          @id @default(cuid())
  pickupPointId   String
  trackingCode    String          @unique
  senderName      String
  recipientName   String
  weight          Float?
  declaredValue   Float?
  status          ReceptionStatus @default(PENDING)
  expectedAt      DateTime?
  receivedAt      DateTime?
  processedAt     DateTime?
  issueType       String?
  issueDetails    String?
  issuePhotos     Json?
  commissionCents Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  pickupPoint     PickupPoint     @relation(fields: [pickupPointId], references: [id], onDelete: Cascade)

  @@index([pickupPointId, status])
  @@index([pickupPointId, receivedAt])
  // Removido @@index([trackingCode]) - trackingCode é @unique
  @@index([status])
  @@map("receptions")
}

model Quote {
  id           String          @id @default(cuid())
  userId       String
  status       QuoteStatus     @default(DRAFT)
  originCep    String          @db.VarChar(8)
  destCep      String          @db.VarChar(8)
  documentType DocumentType
  nfeNumber    String?
  nfeValue     Decimal?        @db.Decimal(10, 2)
  isReverse    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  expiresAt    DateTime
  selectedAt   DateTime?
  confirmedAt  DateTime?
  options      QuoteOption[]
  selection    QuoteSelection?
  volumes      QuoteVolume[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("quotes")
}

model QuoteVolume {
  id          String  @id @default(cuid())
  quoteId     String
  height      Int
  width       Int
  length      Int
  weight      Decimal @db.Decimal(6, 2)
  cubicWeight Decimal @db.Decimal(6, 2)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_volumes")
}

model QuoteOption {
  id              String   @id @default(cuid())
  quoteId         String
  carrierId       String
  carrierName     String
  serviceId       String
  serviceName     String
  basePriceCents  Int
  insuranceCents  Int      @default(0)
  additionalCents Int      @default(0)
  discountCents   Int      @default(0)
  totalCents      Int
  deliveryDays    Int
  metadata        Json?
  createdAt       DateTime @default(now())
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([quoteId, totalCents])
  @@map("quote_options")
}

model QuoteSelection {
  id           String   @id @default(cuid())
  quoteId      String   @unique
  optionId     String
  carrierName  String
  serviceName  String
  totalCents   Int
  deliveryDays Int
  selectedAt   DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_selections")
}

model Carrier {
  id                        String                 @id @default(cuid())
  name                      String
  slug                      String                 @unique
  status                    IntegrationStatus      @default(ACTIVE)
  environment               IntegrationEnvironment @default(PRODUCTION)
  baseUrl                   String?
  timeout                   Int                    @default(30000)
  maxRetries                Int                    @default(3)
  logoUrl                   String?
  description               String?
  /// Comissao sobre frete (%) - aplicada nas cotacoes desta transportadora
  shippingCommissionPercent Decimal?               @map("shipping_commission_percent") @db.Decimal(5, 2)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  credentials               CarrierCredential[]

  @@index([slug])
  @@index([status])
  @@map("carriers")
}

model CarrierCredential {
  id            String                 @id @default(cuid())
  carrierId     String
  environment   IntegrationEnvironment
  authType      AuthType
  apiKey        String?
  clientId      String?
  clientSecret  String?
  username      String?
  password      String?
  token         String?
  tokenUrl      String?
  scope         String?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  customHeaders Json?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  lastRotatedAt DateTime?
  carrier       Carrier                @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@index([carrierId, environment, isActive])
  @@map("carrier_credentials")
}

model PaymentGateway {
  id             String                 @id @default(cuid())
  name           String
  slug           String                 @unique
  status         IntegrationStatus      @default(ACTIVE)
  environment    IntegrationEnvironment @default(PRODUCTION)
  baseUrl        String?
  timeout        Int                    @default(30000)
  enabledMethods PaymentMethod[]
  logoUrl        String?
  description    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  credentials    PaymentCredential[]
  endpoints      PaymentEndpoint[]
  transactions   PaymentTransaction[]
  webhooks       PaymentWebhook[]

  @@index([slug])
  @@index([status])
  @@map("payment_gateways")
}

model PaymentCredential {
  id            String                 @id @default(cuid())
  gatewayId     String
  environment   IntegrationEnvironment
  authType      AuthType
  merchantId    String?
  apiKey        String?
  publicKey     String?
  secretKey     String?
  clientId      String?
  clientSecret  String?
  accessToken   String?
  refreshToken  String?
  applicationId String? // Mercado Pago Application ID
  expiresAt     DateTime?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
