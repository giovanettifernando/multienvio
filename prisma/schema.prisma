// Prisma Schema para Envio Legal
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Roles (papéis/permissões)
model Role {
  id        String   @id @default(uuid())
  name      String   @unique // "admin", "user", "suporte", etc
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

// Modelo de Usuário
model User {
  id                    String    @id @default(uuid())
  name                  String
  email                 String    @unique
  passwordHash          String?   // Nullable para permitir OAuth futuramente
  passwordUpdatedAt     DateTime? // Data da última alteração de senha
  passwordHistory       Json?     // Últimos N hashes de senha (evitar reutilização)
  tokenVersion          Int       @default(0) // Versão do token para invalidação global de sessões
  phone                 String?
  cpf                   String?   // CPF sem máscara (apenas números)
  avatarUrl             String?   // URL do avatar
  hasCompany            Boolean   @default(false) // Se o usuário tem empresa
  cnpj                  String?   // CNPJ sem máscara (apenas números)
  razaoSocial           String?   // Razão social da empresa
  status                String    @default("pending") // "pending", "active", "blocked"
  emailVerified         Boolean   @default(false)
  emailVerificationToken String?  @unique
  emailVerifiedAt       DateTime?
  resetPasswordToken    String?   @unique
  resetPasswordExpiry   DateTime?
  termsAcceptedAt       DateTime? // Data de aceite dos termos
  roleId                String?
  role                  Role?     @relation(fields: [roleId], references: [id])
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relacionamentos
  addresses         Address[]
  sentShipments     Shipment[] @relation("SenderShipments")
  receivedShipments Shipment[] @relation("RecipientShipments")
  cards             Card[]
  recipients        Recipient[]
  securityEvents    UserSecurityEvent[]
  passwordResetTokens PasswordResetToken[]
  wallet            Wallet?
  supportTickets    SupportTicket[]

  @@index([email])
  @@index([emailVerificationToken])
  @@index([resetPasswordToken])
  @@map("users")
}

// Modelo de Endereço
model Address {
  id          String   @id @default(uuid())
  label       String?  // Ex: "Casa", "Trabalho", "Escritório"
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String   @db.VarChar(2)
  isDefault   Boolean  @default(false) // Endereço padrão do usuário
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  billingCards Card[]  @relation("BillingAddress")

  @@index([userId])
  @@index([cep])
  @@map("addresses")
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

model Card {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand            CardBrand
  holderName       String
  last4            String     @db.VarChar(4)
  expMonth         Int
  expYear          Int
  fingerprint      String
  isDefault        Boolean    @default(false)
  billingAddressId String?
  billingAddress   Address?   @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  vaultToken       String     @unique
  panCipher        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@unique([userId, fingerprint])
  @@map("cards")
}

model Recipient {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  nameSearch   String
  email        String?  @db.VarChar(160)
  document     String?  @db.VarChar(14)
  phone        String?  @db.VarChar(20)
  notes        String?  @db.VarChar(280)
  isDefault    Boolean  @default(false)
  cep          String   @db.VarChar(8)
  logradouro   String
  numero       String   @db.VarChar(20)
  complemento  String?
  bairro       String
  cidade       String
  uf           String   @db.VarChar(2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@index([userId, document])
  @@index([userId, name])
  @@index([userId, nameSearch])
  @@map("recipients")
}

// Modelo de Envio/Remessa
model Shipment {
  id               String   @id @default(uuid())
  trackingCode     String   @unique
  senderId         String
  sender           User     @relation("SenderShipments", fields: [senderId], references: [id])
  recipientId      String
  recipient        User     @relation("RecipientShipments", fields: [recipientId], references: [id])
  weight           Float // em kg
  declaredValue    Float // valor declarado em R$
  status           String   @default("criado") // "criado", "postado", "em_transporte", "entregue", "cancelado"
  carrier          String? // transportadora
  service          String? // serviço (PAC, SEDEX, etc)
  originCep        String
  destinationCep   String
  estimatedDays    Int? // prazo estimado em dias
  freightCost      Float? // custo do frete em R$
  postedAt         DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relacionamentos
  trackingEvents TrackingEvent[]

  @@index([trackingCode])
  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@map("shipments")
}

// Modelo de Evento de Rastreamento
model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type        String // "posted", "in_transit", "out_for_delivery", "delivered", "exception"
  description String
  city        String?
  uf          String?  @db.VarChar(2)
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([shipmentId])
  @@index([occurredAt])
  @@map("tracking_events")
}

// ============================================================================
// STAFF AUTHENTICATION (Separate from customer auth)
// ============================================================================

enum StaffStatus {
  ACTIVE
  BLOCKED
}

// Modelo de Roles para Staff (separado de User roles)
model StaffRole {
  id        String      @id @default(cuid())
  name      String      @unique // "admin", "operator", "finance", "support"
  createdAt DateTime    @default(now())
  users     StaffUser[]

  @@map("staff_roles")
}

// Modelo de Usuário Staff (Painel Administrativo)
model StaffUser {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String       @map("passwordHash") // Map to exact DB column name
  status       StaffStatus  @default(ACTIVE)
  roleId       String       @map("roleId") // Map to exact DB column name
  role         StaffRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  lastLoginAt  DateTime?    @map("lastLoginAt") // Map to exact DB column name
  createdAt    DateTime     @default(now()) @map("createdAt") // Map to exact DB column name
  updatedAt    DateTime     @updatedAt @map("updatedAt") // Map to exact DB column name
  auditLogs    StaffAuditLog[]

  @@index([email])
  @@map("staff_users")
}

// Modelo de Auditoria de Ações Administrativas
model StaffAuditLog {
  id        String     @id @default(cuid())
  actorId   String?
  actor     StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String     // "login", "create_staff", "update_role", etc
  entity    String     // "StaffUser", "User", "Shipment", etc
  entityId  String?
  data      Json?      // Dados adicionais da ação
  createdAt DateTime   @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("staff_audit_logs")
}

// Modelo de Eventos de Segurança de Usuários
model UserSecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "PASSWORD_CHANGED", "PASSWORD_RESET", "LOGIN_FAILED", "SESSION_INVALIDATED", etc
  ip        String?
  userAgent String?
  metadata  Json?    // Dados adicionais do evento
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
  @@map("user_security_events")
}

// Modelo de Token de Reset de Senha
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // Hash SHA-256 do token (nunca armazenar token em claro)
  expiresAt DateTime  // Token expira em 1 hora
  usedAt    DateTime? // Marca quando o token foi utilizado (uso único)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ============================================================================
// WALLET (Carteira Digital)
// ============================================================================

enum WalletTxType {
  TOPUP       // Recarga/adição de saldo
  PURCHASE    // Compra/débito
  REFUND      // Reembolso
  WITHDRAW    // Saque
  ADJUSTMENT  // Ajuste manual
}

enum WalletTxStatus {
  PENDING   // Pendente de confirmação
  CONFIRMED // Confirmado
  FAILED    // Falhou
  CANCELED  // Cancelado
}

model Wallet {
  id              String              @id @default(cuid())
  userId          String              @unique
  availableCents  Int                 @default(0) // Saldo disponível em centavos
  pendingCents    Int                 @default(0) // Saldo pendente em centavos
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]

  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id           String         @id @default(cuid())
  walletId     String
  type         WalletTxType
  status       WalletTxStatus @default(PENDING)
  amountCents  Int            // Positivo para crédito, negativo para débito
  title        String?
  referenceId  String?        @unique // Para idempotência
  meta         Json?          // Metadados adicionais
  createdAt    DateTime       @default(now())
  confirmedAt  DateTime?
  wallet       Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status, createdAt])
  @@index([referenceId])
  @@map("wallet_transactions")
}

// ============================================================================
// SUPPORT (Tickets)
// ============================================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportAuthorRole {
  USER
  AGENT
}

model SupportTicket {
  id             String               @id @default(cuid())
  userId         String
  subject        String
  description    String
  status         SupportTicketStatus  @default(OPEN)
  priority       SupportPriority      @default(MEDIUM)
  assignedTo     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  lastActivityAt DateTime             @default(now())
  tags           Json?
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
  @@index([assignedTo])
  @@map("support_tickets")
}

model SupportMessage {
  id         String            @id @default(cuid())
  ticketId   String
  authorId   String
  authorRole SupportAuthorRole
  body       String
  isInternal Boolean           @default(false)
  createdAt  DateTime          @default(now())
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportAttachment {
  id        String         @id @default(cuid())
  messageId String
  filename  String
  url       String
  size      Int?
  createdAt DateTime       @default(now())
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("support_attachments")
}

