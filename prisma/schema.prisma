// RESERVA DE CÓDIGOS DE RASTREAMENTO
// =====================================================

/// Reserva de códigos de rastreamento para garantir unicidade
/// Códigos são reservados antes do pagamento e usados após confirmação
model TrackingCodeReservation {
  id         String    @id @default(cuid())
  code       String    @unique // EL1734567890ABCDE - código único reservado
  userId     String    @map("user_id")
  shipmentId String?   @unique @map("shipment_id") // Preenchido quando shipment é criado
  usedAt     DateTime? @map("used_at") // null = não usado, preenchido quando shipment criado
  expiresAt  DateTime  @map("expires_at") // Expira em 24h se não usado
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("tracking_code_reservations")
}

// =====================================================
// FRETE PAGO PELO DESTINATÁRIO
// =====================================================

/// Solicitação de pagamento de frete pelo destinatário
/// Armazena todos os dados necessários para criar o Shipment após pagamento
model RecipientPaymentRequest {
  id String @id @default(uuid())

  // Remetente
  senderId String @map("sender_id")
  sender   User   @relation(fields: [senderId], references: [id])

  // Origem
  originAddressId    String? @map("origin_address_id")
  originCep          String  @map("origin_cep") @db.VarChar(8)
  originCity         String  @map("origin_city")
  originState        String  @map("origin_state") @db.VarChar(2)
  originAddress      String? @map("origin_address")
  originNeighborhood String? @map("origin_neighborhood")
  originNumber       String? @map("origin_number")
  originComplement   String? @map("origin_complement")

  // Destinatário (quem vai pagar)
  recipientName     String  @map("recipient_name")
  recipientEmail    String  @map("recipient_email")
  recipientPhone    String? @map("recipient_phone")
  recipientDocument String? @map("recipient_document")

  // Destino
  destinationCep          String  @map("destination_cep") @db.VarChar(8)
  destinationCity         String  @map("destination_city")
  destinationState        String  @map("destination_state") @db.VarChar(2)
  destinationAddress      String? @map("destination_address")
  destinationNeighborhood String? @map("destination_neighborhood")
  destinationNumber       String? @map("destination_number")
  destinationComplement   String? @map("destination_complement")

  // Totais do envio (consolidado)
  totalWeight   Float @map("total_weight")
  declaredValue Float @map("declared_value")

  // Cotação selecionada
  carrier       String
  service       String
  serviceCode   String? @map("service_code")
  estimatedDays Int?    @map("estimated_days")

  // Valores (em centavos para precisão)
  freightCostCents Int  @map("freight_cost_cents")
  pickupFeeCents   Int? @map("pickup_fee_cents")
  totalCents       Int  @map("total_cents")

  // Comissões registradas (para reconciliação)
  shippingCommissionCents Int? @map("shipping_commission_cents")
  pickupCommissionCents   Int? @map("pickup_commission_cents")

  // Opções
  pickupAtOrigin Boolean @default(false) @map("pickup_at_origin")

  // Documento fiscal
  document Json?

  // Link de pagamento
  paymentToken String @unique @default(cuid()) @map("payment_token")

  // Status e datas
  status      RecipientPaymentStatus @default(PENDING)
  expiresAt   DateTime               @map("expires_at")
  paidAt      DateTime?              @map("paid_at")
  cancelledAt DateTime?              @map("cancelled_at")

  // Referência ao shipment criado (após pagamento)
  shipmentId String?   @unique @map("shipment_id")
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  // Volumes do envio
  packages RecipientPaymentPackage[]

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([senderId])
  @@index([paymentToken])
  @@index([status])
  @@index([expiresAt])
  @@index([senderId, status])
  @@map("recipient_payment_requests")
}

/// Volumes de uma solicitação de pagamento pelo destinatário
/// Clone simplificado da tabela Package (sem campos de divergência/tracking)
model RecipientPaymentPackage {
  id            String @id @default(uuid())
  requestId     String @map("request_id")
  packageNumber Int    @map("package_number")
  width         Float // Largura em cm
  height        Float // Altura em cm
  length        Float // Comprimento em cm
  weight        Float // Peso em kg

  request RecipientPaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, packageNumber])
  @@index([requestId])
  @@map("recipient_payment_packages")
}

// ============================================================================
// OpenRouter / Assistant AI Configuration
// ============================================================================

/// Configuração da integração com OpenRouter para o Assistente AI
model OpenRouterConfig {
  id               String   @id @default(cuid())
  apiKey           String // Criptografada com AES-256-GCM
  baseUrl          String   @default("https://openrouter.ai/api/v1") @map("base_url")
  defaultModel     String   @default("anthropic/claude-3-haiku") @map("default_model")
  temperature      Float    @default(0.7)
  maxTokens        Int      @default(2048) @map("max_tokens")
  streamingEnabled Boolean  @default(true) @map("streaming_enabled")
  httpReferer      String?  @map("http_referer")
  xTitle           String?  @map("x_title")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("openrouter_configs")
}

/// Sessão de chat do assistente - agrupa mensagens de uma conversa
model AssistantChatSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String? // Título opcional gerado automaticamente
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantChatMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("assistant_chat_sessions")
}

/// Mensagem individual de uma sessão do assistente
model AssistantChatMessage {
  id         String                 @id @default(cuid())
  sessionId  String                 @map("session_id")
  author     AssistantMessageAuthor
  content    String                 @db.Text
  toolName   String?                @map("tool_name")
  toolArgs   Json?                  @map("tool_args")
  toolResult Json?                  @map("tool_result")
  createdAt  DateTime               @default(now()) @map("created_at")

  session AssistantChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("assistant_chat_messages")
}

/// Autor da mensagem no chat do assistente
enum AssistantMessageAuthor {
  USER
  ASSISTANT
  TOOL
}

// ============================================================================
// Knowledge Base (Base de Conhecimento)
// ============================================================================

/// Artigo da base de conhecimento para consulta pelo assistente
model KnowledgeBaseArticle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  contentMarkdown String   @map("content_markdown") @db.Text
  tags            String[] // PostgreSQL array para tags
  category        String?
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([category])
  @@map("knowledge_base_articles")
}
