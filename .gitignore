# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# DB local / volumes Docker
_data/
data/
postgres-data/
public/uploads/

# Logs (pino-roll)
logs/

# Notas locais — nunca versionar (anotações pessoais, pesquisas, rascunhos)
notas-locais/

# Logs de desenvolvimento local (pnpm dev / pnpm workers)
dev-server.log
workers.log

# Documentos gerados em runtime (declarações, etiquetas)
storage/generated-documents/

# Credenciais baixadas do Google Cloud (client_secret_*.json) — nunca versionar.
# O app lê as credenciais do banco ou do .env.
google/
client_secret_*.json

# Override local do Postgres (porta diferente por máquina)
_infra/postgres/docker-compose.override.yml

# Sessão de teste gerada pelo Playwright
tests/e2e/.auth/
test-results/
playwright-report/
