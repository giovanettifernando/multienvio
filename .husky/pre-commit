#!/bin/sh
#
# Pre-commit hook - Verificações de segurança e qualidade
#
# Este hook executa:
# 1. Verificação de arquivos sensíveis no staging
# 2. Type checking (TypeScript)
# 3. Linting (ESLint)
# 4. Auditoria de segurança (npm audit - apenas high/critical)
#

# Cores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo "🔒 Pre-commit: Executando verificações de segurança..."
echo ""

# ─────────────────────────────────────────────────────────────────
# 1. Verificar arquivos sensíveis no staging
# ─────────────────────────────────────────────────────────────────
echo "📁 Verificando arquivos sensíveis..."

# Patterns de arquivos que não devem ser commitados
SENSITIVE_FILES=$(git diff --cached --name-only | grep -E '\.(env|pem|key|p12|pfx)$|credentials\.json|service-account\.json|id_rsa|id_ed25519' || true)

if [ -n "$SENSITIVE_FILES" ]; then
  echo ""
  echo "${RED}❌ ERRO: Arquivos sensíveis detectados no staging:${NC}"
  echo "$SENSITIVE_FILES"
  echo ""
  echo "Remova-os com: git reset HEAD <arquivo>"
  exit 1
fi

echo "✓ Nenhum arquivo sensível no staging"
echo ""

# ─────────────────────────────────────────────────────────────────
# 2. Verificar secrets hardcoded em arquivos staged
# ─────────────────────────────────────────────────────────────────
echo "🔑 Verificando secrets hardcoded..."

# Pegar conteúdo dos arquivos staged (apenas TS/TSX/JS/JSX)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -n "$STAGED_FILES" ]; then
  # Buscar por patterns de secrets
  for file in $STAGED_FILES; do
    # Verificar apenas o conteúdo staged (não o arquivo completo)
    SECRETS=$(git diff --cached "$file" | grep -E '^\+' | grep -iE 'api[_-]?key\s*[:=]\s*["\047][^"\047]{10,}|secret\s*[:=]\s*["\047][^"\047]{10,}|password\s*[:=]\s*["\047][^"\047]{6,}|bearer\s+[a-z0-9_-]{20,}' | grep -v 'process\.env' || true)

    if [ -n "$SECRETS" ]; then
      echo ""
      echo "${YELLOW}⚠️  Possível secret em $file:${NC}"
      echo "$SECRETS" | head -3
      echo ""
      echo "Se for um falso positivo, use: git commit --no-verify"
      exit 1
    fi
  done
fi

echo "✓ Nenhum secret hardcoded detectado"
echo ""

# ─────────────────────────────────────────────────────────────────
# 3. Type checking (apenas em arquivos TypeScript alterados)
# ─────────────────────────────────────────────────────────────────
echo "📝 Verificando tipos TypeScript..."

# Verificar se há arquivos TS/TSX no staging
TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -n "$TS_FILES" ]; then
  # Executar tsc com timeout de 60 segundos
  if ! timeout 60 npx tsc --noEmit 2>/dev/null; then
    echo ""
    echo "${RED}❌ ERRO: Erros de TypeScript detectados${NC}"
    echo "Execute 'npx tsc --noEmit' para ver os detalhes"
    exit 1
  fi
  echo "✓ TypeScript OK"
else
  echo "✓ Nenhum arquivo TypeScript alterado"
fi
echo ""

# ─────────────────────────────────────────────────────────────────
# 4. Linting (apenas arquivos staged)
# ─────────────────────────────────────────────────────────────────
echo "🔍 Executando ESLint..."

if [ -n "$STAGED_FILES" ]; then
  # ESLint apenas nos arquivos staged (ignora avisos, falha em erros)
  if ! npx eslint $STAGED_FILES --quiet --max-warnings=0 2>/dev/null; then
    echo ""
    echo "${YELLOW}⚠️  Avisos de ESLint detectados${NC}"
    echo "Execute 'npm run lint' para ver os detalhes"
    # Não bloqueia o commit por warnings, apenas erros
  fi
  echo "✓ ESLint OK"
else
  echo "✓ Nenhum arquivo JS/TS alterado"
fi
echo ""

# ─────────────────────────────────────────────────────────────────
# 5. Auditoria de segurança (apenas critical/high)
# ─────────────────────────────────────────────────────────────────
echo "🛡️  Verificando vulnerabilidades npm..."

# npm audit com nível critical apenas (high são monitorados mas não bloqueiam)
AUDIT_OUTPUT=$(npm audit --json 2>/dev/null || true)
CRITICAL=$(echo "$AUDIT_OUTPUT" | jq -r '.metadata.vulnerabilities.critical // 0' 2>/dev/null || echo "0")
HIGH=$(echo "$AUDIT_OUTPUT" | jq -r '.metadata.vulnerabilities.high // 0' 2>/dev/null || echo "0")

if [ "$CRITICAL" -gt 0 ]; then
  echo ""
  echo "${RED}❌ ERRO: Vulnerabilidades críticas detectadas${NC}"
  echo "   Critical: $CRITICAL"
  echo ""
  echo "Execute 'npm audit' para detalhes ou 'npm audit fix' para corrigir"
  exit 1
fi

if [ "$HIGH" -gt 0 ]; then
  echo "${YELLOW}⚠️  $HIGH vulnerabilidade(s) high (transitivas sem fix upstream)${NC}"
else
  echo "✓ Nenhuma vulnerabilidade critical/high"
fi
echo ""

# ─────────────────────────────────────────────────────────────────
# Sucesso
# ─────────────────────────────────────────────────────────────────
echo "${GREEN}✅ Todas as verificações passaram!${NC}"
echo ""

exit 0
